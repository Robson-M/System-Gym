<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configurações</title>
  <%= stylesheet_link_tag "application" %>
  <%= stylesheet_link_tag "setting" %>
</head>
<body>
  <%= render "partials/header" %>
  <main class="main">

    <!-- CABEÇALHO -->
    <header class="page-header">
      <div>
        <h1 class="page-header__title">Configurações</h1>
      </div>
    </header>

    <p class="settings-label">Gerenciamento do sistema</p>
    <div class="settings-nav-grid">
      <%= link_to users_path, class:"settings-nav-card" do %>
        <div class="settings-nav-card__icon">
          <svg vieBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="settings-nav-card__body">
          <div class="settings-nav-card__title">Usuários do sistema</div>
          <div class="settings-nav-card__desc">Funcionários com acesso ao painel</div>
        </div>
        <svg class="settings-nav-card__arrow" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      <% end %>

      <a href="#" class="settings-nav-card">
        <div class="settings-nav-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div class="settings-nav-card__body">
          <div class="settings-nav-card__title">Integração com catraca</div>
          <div class="settings-nav-card__desc">Controle de acesso e check-in</div>
        </div>
        <svg class="settings-nav-card__arrow" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="#" class="settings-nav-card">
        <div class="settings-nav-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="settings-nav-card__body">
          <div class="settings-nav-card__title">Histórico de acessos</div>
          <div class="settings-nav-card__desc">Entradas e saídas registradas</div>
        </div>
        <svg class="settings-nav-card__arrow" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="#" class="settings-nav-card">
        <div class="settings-nav-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
        </div>
        <div class="settings-nav-card__body">
          <div class="settings-nav-card__title">Relatórios</div>
          <div class="settings-nav-card__desc">Exportar dados e relatórios</div>
        </div>
        <svg class="settings-nav-card__arrow" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="#" class="settings-nav-card">
        <div class="settings-nav-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <div class="settings-nav-card__body">
          <div class="settings-nav-card__title">Backup do sistema</div>
          <div class="settings-nav-card__desc">Exportar e restaurar dados</div>
        </div>
        <svg class="settings-nav-card__arrow" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="#" class="settings-nav-card">
        <div class="settings-nav-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <div class="settings-nav-card__body">
          <div class="settings-nav-card__title">Guia do sistema</div>
          <div class="settings-nav-card__desc">Guia de uso do sistema</div>
        </div>
        <svg class="settings-nav-card__arrow" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- ── PERSONALIZAÇÃO ── -->
    <p class="settings-label">Personalização da academia</p>
    <div class="settings-card">
      <div class="settings-card__header">
        <div class="settings-card__header-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </div>
        <div>
          <div class="settings-card__title">Identidade da Academia</div>
          <div class="settings-card__subtitle">Logo, nome e informações gerais</div>
        </div>
      </div>
      
      <%= form_with(model: @gym) do |form| %>
        <div class="settings-card__body">
          <div class="logo-upload">
            <div class="logo-preview" aria-hidden="true">N</div>
            <div class="logo-upload__info">
              <div class="logo-upload__title">Logo da academia</div>
              <div class="logo-upload__hint">PNG ou SVG · Tamanho máximo 2MB · Recomendado 256×256px</div>
              <div class="logo-upload__actions">
                <button class="btn-ghost btn-upload" type="button">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Enviar imagem
                </button>
                <button class="btn-ghost btn-remove" type="button">
                  Remover
                </button>
              </div>
            </div>
          </div>

          <!-- Campos de texto -->
          <div class="settings-fields">
            <div class="settings-field">
              <%= form.label "Nome da academia", class:"settings-field__label" %>
              <%= form.text_field :gym_name, class:"settings-field__input" %>
            </div>
            <div class="settings-field">
              <%= form.label "Telefone de contato", class:"settings-field__label" %>
              <%= form.text_field :gym_phone, class:"settings-field__input" %>
            </div>
            <div class="settings-field">
              <%= form.label "E-mail da academia", class:"settings-field__label" %>
              <%= form.text_field :gym_email, class:"settings-field__input" %>
            </div>
            <div class="settings-field">
              <%= form.label "Endereço", class:"settings-field__label" %>
              <%= form.text_field :gym_address, class:"settings-field__input" %>
            </div>
          </div>
        </div>

        <div class="settings-card__footer">
          <button type="submit" class="btn-primary settings-button_sabe" %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Salvar identidade
          </button>
        </div>
      <% end %>
    </div>
  
    <!-- Card: cores do sistema -->
    <div class="settings-card">
      <div class="settings-card__header">
        <div class="settings-card__header-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
        </div>
        <div>
          <div class="settings-card__title">Cores do sistema</div>
          <div class="settings-card__subtitle">Paleta principal usada em toda a interface</div>
        </div>
      </div>

      <div class="settings-card__body">
        <div class="color-grid">
          <div class="color-field">
            <label class="color-field__label">Cor primária</label>
            <div class="color-field__picker">
              <input class="color-field__swatch" type="color" value="#5179b3" aria-label="Selecionar cor primária">
              <input class="color-field__hex" type="text" value="#5179b3" maxlength="7">
            </div>
            <span class="settings-field__hint">Botões, links e destaques</span>
          </div>

          <div class="color-field">
            <label class="color-field__label">Cor secundária</label>
            <div class="color-field__picker">
              <input class="color-field__swatch" type="color" value="#9db9e1" aria-label="Selecionar cor secundária">
              <input class="color-field__hex" type="text" value="#9db9e1" maxlength="7">
            </div>
            <span class="settings-field__hint">Bordas e elementos sutis</span>
          </div>

          <div class="color-field">
            <label class="color-field__label">Cor de destaque</label>
            <div class="color-field__picker">
              <input class="color-field__swatch" type="color" value="#6296e0" aria-label="Selecionar cor de destaque">
              <input class="color-field__hex" type="text" value="#6296e0" maxlength="7">
            </div>
            <span class="settings-field__hint">Hover, foco e badges</span>
          </div>
        </div>
      </div>

      <div class="settings-card__footer">
        <button class="btn-ghost settings-button_save" type="button" >Restaurar padrão</button>
        <button class="btn-primary settings-button_save" type="button" >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Salvar cores
        </button>
      </div>
    </div>
  </main>
</body>
</html>