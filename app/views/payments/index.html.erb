<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pagamentos</title>
  <%= stylesheet_link_tag "application" %>
  <%= stylesheet_link_tag "forms" %>
</head>
<body>
  <%= render "partials/header" %>
  <main class="main">

    <!-- CABEÇALHO -->
    <header class="page-header">
      <div>
        <h1 class="page-header__title"><%= @student.name_student %></h1>
        <p class="page-header__date">
          <svg class="icon_payments" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          Pagina de pagamentos
        </p>
      </div>

      <div class="page-header__actions">
        <%= link_to student_path(@student), class: "btn-ghost" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Voltar
        <% end %>
      </div>
    </header>

    <!-- MÉTRICAS RÁPIDAS -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-card__header">
          <span class="metric-card__label">Plano atual</span>
          <span class="metric-card__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </span>
        </div>
        <div class="metric-card__value">
          <%= @payment.last_payment&.name_plan_payment %>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-card__header">
          <span class="metric-card__label">Dias para o vencimento</span>
          <span class="metric-card__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </div>
        <div class="metric-card__value">
          <%= @payment.days_until_expiration %>
        </div>
        <div class="metric-card__trend trend--up">
          <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <span class="trend__context">Restantes</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-card__header">
          <span class="metric-card__label">Em Aberto</span>
          <span class="metric-card__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
        </div>
        <div class="metric-card__value">
          <%= @payment.due_date_active %>
        </div>
        <div class="metric-card__trend trend--warn">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span class="trend__context">pendentes</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-card__header">
          <span class="metric-card__label">Próximo Vencimento</span>
          <span class="metric-card__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </span>
        </div>
        <div class="metric-card__value">
          <%= @payment.last_payment&.due_date&.strftime("%d/%m/%Y") %>
        </div>
        <div class="metric-card__trend">
          <span class="trend__context">data de vencimento</span>
        </div>
      </div>
    </div>

    <!-- Mensagem -->
    <% if @payment.errors.any? %>
        <div class="success">
          <% @payment.errors.full_messages.each do |msg| %>
              <p><storng>•</strong> <%= msg %></p>
          <% end %>
        </div>
    <% end %>

    <%= form_with(model: @payment, url: student_payments_path) do |form| %>
      <div class="form-card">
        <div class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <div class="form-section__title">Formulario de pagamento</div>
              <div class="form-section__subtitle">O plano determina o valor das mensalidades e a duração da matrícula.</div>
            </div>
          </div>

          <div class="form-grid form-grid--3 form-col-full">
            <div class="form-group">
              <label class="form-label" for="plan_id">
                Plano <sup>*</sup>
              </label>
              <div class="form-select-wrapper">
                <%= form.collection_select :plan_id, @plans, :id, :name_plan, { prompt: "Selecione um plano" }, { class:"form-select" } %>
                <svg class="form-select-arrow" viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="payment_method">
                Forma de pagamento <sup>*</sup>
              </label>
              <div class="form-input-wrapper">
                <svg class="form-input-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <%= form.text_field :payment_method, class:"form-input", placeholder:"Ex.: Pix" %>
              </div>
            </div>

            <div class="form-group-btn">
              <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Salvar aluno
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- TABELA DE PAGAMENTOS -->
    <section class="search-results" aria-label="Pagamentos do aluno">
      <h2 class="section-label margin-top_20">Histórico de pagamentos</h2>
      <div class="results-card">
        <table class="results-table">
          <thead>
            <tr>
              <th>Valor</th>
              <th>Plano</th>
              <th>Data de pagamento</th>
              <th>Vencimento</th>
              <th>Método</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if @payments.any? %>
              <% @payments.each do |payment| %>
                <tr>
                  <td>
                    <strong>R$ <%= number_with_precision(payment.amount, precision: 2, delimiter: ".", separator: ",") rescue payment.amount %></strong>
                  </td>
                  <td>
                    <%= payment.name_plan_payment %>
                  <td>
                    <%= payment.paid_at ? payment.paid_at.strftime("%d/%m/%Y") : "—" %>
                  </td>
                  <td>
                    <%= payment.due_date ? payment.due_date.strftime("%d/%m/%Y") : "—" %>
                  </td>
                  <td>
                    <%= payment.payment_method&.capitalize || "—" %>
                  </td>
                  <td>
                    <div class="row-actions">
                      <%= button_to student_payment_path(@student, payment),
                            method: :delete,
                            data: { turbo_confirm: "Remover este pagamento?" },
                            class: "btn-row-action" do %>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="error-payment">
                  <svg class="icon-payment-error" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                  Nenhum pagamento registrado para este aluno.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>