<!-- ═══ HEADER ═══ -->
  <header class="top-header">
    <div class="top-header__bar1">
      <div class="top-header__brand">
        <div class="top-header__mark" aria-hidden="true">N</div>
        <span class="top-header__brand-name">NextFit Admin</span>
      </div>

      <div class="top-header__actions">
        <button class="top-header__badge-btn" type="button">
          Novidades
          <span class="top-header__dot"></span>
        </button>

        <div class="top-header__sep"></div>

        <a href="https://wa.me/0000000000000" class="top-header__help-btn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          Central de ajuda
        </a>

        <div class="top-header__sep"></div>

        <button class="btn-icon" type="button" aria-label="Notificações">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <span class="btn-icon__dot"></span>
        </button>

        <%= link_to settings_path, class:"btn-icon" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        <% end %>

        <div class="top-header__sep"></div>

        <%= link_to users_path, class:"top-header__user" do %>
          <div class="avatar avatar--sm avatar--admin" aria-hidden="true">
            <%= current_user.name_user.split.map(&:first).first(2).join.upcase rescue "AD" %>
          </div>
          <div class="top-header__user-text">
            <span class="top-header__user-name"><%= current_user.name_user rescue "Administrador" %></span>
            <span class="top-header__user-role">Administrador</span>
          </div>
        <% end %>

        <div class="top-header__sep"></div>

        <%= button_to destroy_user_session_path,
              method: :delete,
              class: "btn-icon",
              title: "Sair do sistema",
              data: { turbo_confirm: "Deseja encerrar a sessão?" } do %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        <% end %>

      </div>
    </div>



