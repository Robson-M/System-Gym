<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuários do Sistema | NextFit Admin</title>
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "userspage" %>
</head>
<body>

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="sidebar">
    <div class="sidebar__body">
        <div class="sidebar__brand">
            <div class="sidebar__logo" aria-hidden="true">N</div>
            <span class="sidebar__name">NextFit Admin</span>
        </div>

        <nav aria-label="Menu principal">
        <ul class="sidebar__nav">
            <li class="nav-item">
                <%= link_to students_path, class: "nav-item__link" do %>
                    <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Alunos
                <% end %>
            </li>
            <li class="nav-item">
                <%= link_to plans_path, class: "nav-item__link" do %>
                    <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    Planos
                <% end %>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-item__link">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Financeiro
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-item__link">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    Relatórios
                </a>
            </li>
            <li class="nav-item nav-item--active">
                <%= link_to settings_path, class:"nav-item__link" do %>
                    <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    Configurações
                <% end %>
            </li>
        </ul>
        </nav>
    </div>

    <footer class="sidebar__footer">
        <div class="avatar avatar--md avatar--admin" aria-hidden="true">
            <%= current_user.name_user.split.map(&:first).first(2).join.upcase rescue "AD" %>
        </div>
        <div>
            <span class="sidebar__user-name"><%= current_user.name_user rescue "Administrador" %></span>
            <span class="sidebar__user-role">Administrador</span>
        </div>
    </footer>
    </aside>

    <!-- ═══ MAIN ═══ -->
    <main class="main">

    <!-- CABEÇALHO -->
    <header class="page-header">
        <div>
            <h1 class="page-header__title">Usuários do Sistema</h1>
            <p class="page-header__date">Funcionários com acesso ao painel administrativo</p>
        </div>

        <div class="devise-bar__actions">
            <%= link_to new_user_registration_path, class: "btn-ghost" do %>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                Novo usuário
            <% end %>
            <%= link_to edit_user_registration_path, class: "btn-ghost" do %>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar meu perfil
            <% end %>
            <%= button_to destroy_user_session_path, method: :delete, data: { turbo_confirm: "Deseja encerrar a sessão?" }, class: "btn-ghost btn-exit" do %>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sair do sistema
            <% end %>
        </div>
    </header>

    <!-- ── BARRA DE AÇÕES DO DEVISE ── -->
    <div class="devise-bar">
        <div class="devise-bar__info">
        <div class="avatar avatar--sm avatar--admin" aria-hidden="true">
            <%= current_user.name_user.split.map(&:first).first(2).join.upcase rescue "AD" %>
        </div>
        <div>
            <span class="devise-bar__label">Sessão ativa: <strong><%= current_user.name_user rescue "Administrador" %></strong></span>
        </div>
        </div>
    </div>

    <!-- ── LISTA DE USUÁRIOS ── -->
    <p class="section-label">Usuários cadastrados</p>

    <div class="results-card">
        <table class="results-table">
        <thead>
            <tr>
            <th>Usuário</th>
            <th>CPF</th>
            <th>Telefone</th>
            <th>Cadastrado em</th>
            <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if @users.any? %>
            <% @users.each do |user| %>
                <tr>
                    <td>
                        <div class="user-cell">
                        <div class="avatar avatar--sm avatar--admin" aria-hidden="true">
                            <%= user.name_user.split.map(&:first).first(2).join.upcase rescue "?" %>
                        </div>
                        <div>
                            <span class="student-cell__name"><%= user.name_user %></span>
                            <span class="student-cell__email">Administrador</span>
                        </div>
                        </div>
                    </td>

                    <td>
                        <%= user.cpf.to_s.sub(/(\d{3})(\d{3})(\d{3})(\d{2})/, '\1.\2.\3-\4') rescue user.cpf %>
                    </td>

                    <td>
                        <%= user.phone_user.present? ? user.phone_user.to_s.gsub(/\D/, '').sub(/(\d{2})(\d{5})(\d{4})/, '(\1)\2-\3') : "—" %>
                    </td>

                    <td>
                        <%= user.created_at.strftime("%d/%m/%Y") %>
                    </td>

                    <td>
                        <div class="row-actions">
                            <% if user == current_user %>
                                <span class="badge badge--active">Você</span>
                            <% else %>
                                <%= button_to user_path(user), method: :delete, data: { turbo_confirm: "Remover #{user.name_user} do sistema?" },
                                    class: "btn-row-action",
                                    title: "Remover usuário" do %>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                <% end %>
                            <% end %>
                        </div>
                    </td>
                </tr>
            <% end %>
            <% else %>
            <tr>
                <td colspan="5" style="text-align: center; padding: 48px 20px; color: var(--color-muted);">
                <svg style="display:block;margin:0 auto 12px;width:32px;height:32px;stroke:currentColor;fill:none;stroke-width:1.5;opacity:.4;" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Nenhum usuário cadastrado.
                </td>
            </tr>
            <% end %>
        </tbody>
        </table>
    </div>
        
    </main>

</body>
</html>