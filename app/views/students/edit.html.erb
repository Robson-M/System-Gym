<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Aluno</title>
    <%= stylesheet_link_tag "forms" %>
    <%= stylesheet_link_tag "application" %>
</head>
<body>
    <%= render "partials/header" %>

    <main class="main">
        
        <!-- Cabeçalho -->
        <header class="page-header">
                <h1 class="page-header__title">Editar Aluno</h1>
            <div class="page-header__actions">
                <%= link_to student_path(@student), class:"btn-ghost" do %>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Voltar
                <% end %>
            </div>
        </header>

        <!-- Container do Formulário -->
        <div class="form-layout">
            <%= form_with(model: @student) do |form| %>
                <div class="form-card">
                    
                    <div class="form-section">
                        <div class="form-section__header">
                            <div class="form-section__icon">
                                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </div>
                            <div>
                                <h2 class="form-section__title">Dados Pessoais</h2>
                                <p class="form-section__subtitle">Informações do aluno</p>
                            </div>
                        </div>

                        <div class="form-grid">
                            <!-- Nome -->
                            <div class="form-group form-col-full">
                                <label class="form-label" for="name_student">Nome completo </label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    <%= form.text_field :name_student, class:"form-input" %>
                                </div>
                            </div>

                            <!-- CPF -->
                            <div class="form-group">
                                <label class="form-label" for="cpf_student">CPF</label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <%= form.number_field :cpf_student, class:"form-input" %>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="form-group">
                                <label class="form-label" for="email_student">Email</label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                    <%= form.text_field :email_student, class:"form-input" %>
                                </div>
                            </div>
                        </div>

                        <div class="form-grid form-grid--3 margin-top_20">
                            <!-- Bairro -->
                            <div class="form-group">
                                <label class="form-label" for="neighborhood">Bairro</label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    <%= form.text_field :neighborhood, class:"form-input" %>
                                </div>
                            </div>

                            <!-- Rua -->
                            <div class="form-group">
                                <label class="form-label" for="street">Rua</label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    <%= form.text_field :street, class:"form-input" %>
                                </div>
                            </div>

                            <!-- Numero -->
                            <div class="form-group">
                                <label class="form-label" for="house_number">Numero</label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v18z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                    <%= form.number_field :house_number, class:"form-input" %>
                                </div>
                            </div>
                        </div>

                        <div class="form-grid margin-top_20">
                            <!-- Data de nascimento -->
                            <div class="form-group">
                                <label class="form-label" for="birth_date">Data de nascimento</label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <%= form.date_field :birth_date, class:"form-input" %>
                                </div>
                            </div>

                            <!-- Telefone / WhatsApp -->
                            <div class="form-group">
                                <label class="form-label" for="phone">Telefone / WhatsApp</label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    <%= form.number_field :phone, class:"form-input" %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Footer do formulário para as ações -->
                    <div class="form-actions">
                        <%= link_to "Cancelar", students_path, class:"btn-ghost" %>
                        <button type="submit" class="btn-primary">
                            <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                            Salvar Aluno
                        </button>
                    </div>
                </div>
            <% end %>
        </div>
    </main>
</body>
</html>