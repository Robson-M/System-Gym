<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Administrativo - NextFit Admin</title>
    <%= stylesheet_link_tag "application" %>
</head>
<body>
  <%= render "partials/header" %>
  <main class="main">

    <!-- BUSCA -->
      <%= form_with url: students_path, method: :get, data: { controller: "search", turbo_frame: "search_results" }, local: true, class:"search-bar" do |form| %>
        <svg class="search-bar__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        
        <%= form.text_field :q, 
          value: params[:q],
          class: "search-bar__input",
          placeholder: "Buscar aluno por nome ou matricula",
          data: { action: "input->search#submit" } %>
          
        <%= form.submit "Buscar", class:"search-bar__submit" %>
      <% end %>

      <section class="search-hero" role="group" aria-label="Filtros rápidos">
        <div class="search-filters">
          <span class="search-filters__label">Filtros rápidos:</span>
          <button class="filter-btn">Todos</button>
          <button class="filter-btn filter-btn--active" aria-pressed="true">Ativos</button>
          <button class="filter-btn">Inativos</button>
          <button class="filter-btn">Vencendo</button>
        </div>
      </section>

      <!-- RESULTADOS -->
      <turbo-frame id="search_results">
      <% if @students&.any? %>
        <section class="search-results" aria-label="Resultados da busca">
          <h2 class="section-label">Resultados da pesquisa para <%= params[:q]&.upcase %> (<%= @students.count %> ENCONTRADOS)</h2>
          <div class="results-grid">
            <div class="results-card">
              <table class="results-table">
                <thead>
                  <tr>
                    <th scope="col">Aluno</th>
                    <th scope="col">CPF</th>
                    <th scope="col">Cadastro</th>
                    <th scope="col">Telefone</th>
                    <th scope="col">Plano</th>
                    <th scope="col">Status</th>
                    <th scope="col">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% @students.each do |student| %>
                    <tr class="is-selected" aria-selected="true">
                      <td>
                        <div class="user-cell">
                          <div class="avatar avatar--sm avatar--admin" aria-hidden="true">
                            <%= avatar_initials(student.name_student) %>
                          </div>
                          <div class="student-cell">
                            <div>    
                              <span class="student-cell__name"><%= student.name_student %></span>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td><%= student.cpf_student.to_s.gsub(/\D/, '').sub(/(\d{3})(\d{3})(\d{3})(\d{2})/, '\1.\2.\3-\4') %></td>
                      <td><%= student.created_at.strftime("%d/%m/%Y") %></td>
                      <td><%= student.phone.to_s.gsub(/\D/, '').sub(/(\d{2})(\d{5})(\d{4})/, '(\1)\2-\3') %></td>
                      <td><%= student.payments.first&.name_plan_payment %></td>
                      <td><span class="badge badge--active"><%= student.payments.first&.due_date_active %></span></td>
                      <td>
                        <div class="row-actions">
                          <%= link_to student_payments_path(student), class:"btn-row-action" do %>
                            <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                          <% end %>
                          <%= link_to student_path(student), class:"btn-row-action" do %>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>                
          </div>
        </section>
      <% end %>                    
      </turbo-frame>
  </main>

</body>
</html>