<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario Aluno</title>
    <%= stylesheet_link_tag "forms" %>
    <%= stylesheet_link_tag "application" %>
</head>
<body>
    <%= render "partials/header" %>
    <main class="main">
        
        <!-- Cabeçalho -->
        <header class="page-header">
            <div>
                <h1 class="page-header__title">Formulario Aluno</h1>
            </div>
            <div class="page-header__actions">
                <%= link_to students_path, class:"btn-ghost" do %>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Voltar
                <% end %>
            </div>
        </header>

        <!-- Container do Formulário -->
        <div class="form-layout">
            <div class="form-card">
                
                <!-- SEÇÃO 1: Dados Pessoais -->
                <div class="form-section">
                    <div class="form-section__header">
                        <div class="form-section__icon">
                            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <div>
                            <h2 class="form-section__title">Formulario</h2>
                            <p class="form-section__subtitle">Informações do aluno</p>
                        </div>

                        <div class="btn-conteiner">
                            <%= link_to student_payments_path(@student), class:"btn-ghost btn-actions" do %>
                                <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                                Pagamentos
                            <% end %>
                            
                            <%= link_to edit_student_path(@student), class:"btn-ghost btn-actions" do %>
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                Editar
                            <% end %>
                            
                            <%= button_to student_path(@student), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class:"btn-ghost btn-action-remove" do %>
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                Deletar
                            <% end %>
                        </div>
                    </div>

                    <div class="form-grid">
                        <!-- Nome -->
                        <div class="form-group form-col-full">
                            <label class="form-label" for="name_student">Nome completo</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                <p class="form-input form-exit"><%= @student.name_student %></p>
                            </div>
                        </div>

                        <!-- CPF -->
                        <div class="form-group">
                            <label class="form-label" for="cpf_student">CPF</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                <p class="form-input form-exit"><%= @student.cpf_student.to_s.gsub(/\D/, '').sub(/(\d{3})(\d{3})(\d{3})(\d{2})/, '\1.\2.\3-\4') %></p>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-group">
                            <label class="form-label" for="email_student">Email</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                <p class="form-input form-exit"><%= @student.email_student %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Endereço -->
                    <div class="form-grid form-grid--3">
                        <!-- Bairro -->
                        <div class="form-group">
                            <label class="form-label" for="neighborhood">Bairro</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                <p class="form-input form-exit"><%= @student.neighborhood %></p>
                            </div>
                        </div>

                        <!-- Rua -->
                        <div class="form-group">
                            <label class="form-label" for="street">Rua</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                <p class="form-input form-exit"><%= @student.street %></p>
                            </div>
                        </div>

                        <!-- Numero -->
                        <div class="form-group">
                            <label class="form-label" for="house_number">Numero</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v18z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                <p class="form-input form-exit"><%= @student.house_number %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Data Nascimento -->
                    <div class="form-grid">
                        <!-- Data de nascimento -->
                        <div class="form-group">
                            <label class="form-label" for="birth_date">Data de nascimento</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                <p class="form-input form-exit"><%= @student.birth_date&.strftime("%d/%m/%Y") %></p>
                            </div>
                        </div>

                        <!-- Telefone / WhatsApp -->
                        <div class="form-group">
                            <label class="form-label" for="phone">Telefone / WhatsApp</label>
                            <div class="form-input-wrapper">
                                <svg class="form-input-icon" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                <p class="form-input form-exit"><%= @student.phone.to_s.gsub(/\D/, '').sub(/(\d{2})(\d{5})(\d{4})/, '(\1)\2-\3')%>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 2: Matrícula -->
                <div class="form-section">
                    <div class="form-section__header">
                        <div class="form-section__icon">
                            <svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                        </div>
                        <div>
                            <h2 class="form-section__title">Matrícula</h2>
                            <p class="form-section__subtitle">Plano vinculado ao aluno</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <!-- ID do Plano -->
                        <div class="form-group form-col-full">
                            <label class="form-label" for="plan_id">Plano</label>
                            <div class="form-select-wrapper">
                                <p class="form-input form-exit"><%= @student.plan&.name_plan %></p>
                            </div>
                        </div>
                    </div>
                </div>                
            </div>
        </div>
    </main>
</body>
</html>