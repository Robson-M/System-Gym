<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Planos | NextFit Admin</title>
  <%= stylesheet_link_tag "application" %>
  <%= stylesheet_link_tag "planspage" %>

  <body>
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar__body">
            <div class="sidebar__brand">
                <div class="sidebar__logo" aria-hidden="true">N</div>
                <span class="sidebar__name">NextFit Admin</span>
            </div>

            <nav aria-label="Menu principal">
                <ul class="sidebar__nav">
                    <li class="nav-item">
                        <%= link_to students_path, class:"nav-item__link" do %>
                            <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            Alunos
                        <% end %>
                    </li>
                    <li class="nav-item">
                        <%= link_to plans_path, class:"nav-item__link" do %>
                            <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            Planos
                        <% end %>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-item__link">
                            <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            Financeiro
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-item__link">
                            <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            Relatórios
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-item__link">
                            <svg class="nav-item__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            Configurações
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <footer class="sidebar__footer">
            <div class="avatar avatar--md avatar--admin" aria-hidden="true">RC</div>
            <div>
                <% if user_signed_in? %>
                    <span class="sidebar__user-name"><%= current_user.name_user %></span>
                    <span class="sidebar__user-role">Administrador</span>
                <% else %>
                    <%= link_to "Fazer Login", new_user_session_path, class: "btn-primary" %>
                <% end %>
            </div>
        </footer>
    </aside>


    <!-- Contêiner principal -->
    <main class="main">
        
        <!-- Cabeçalho -->
        <header class="page-header">
            <div>
                <h1 class="page-header__title">Planos da Academia</h1>
            </div>
            <div class="page-header__actions">
                <%= link_to new_plan_path, class:"btn-primary" do %>
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Novo Plano
                <% end %>
            </div>
        </header>

        <!-- Grid de Planos -->
        <div class="plan-grid">

            <!-- CARD DE PLANOS -->

            <% @plans.each do |plan| %>
            <div class="plan-preview">
                <div class="plan-preview__header">
                    <div class="plan-preview__header-icon">
                        <svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                    <div>
                        <div class="plan-preview__header-title"><%= plan.name_plan %></div>
                        <div class="plan-preview__header-sub">Cobrança recorrente a cada <strong><%= plan.duration_days %></strong> dias</div>
                    </div>
                </div>
                <div class="plan-preview__body">
                    <div class="plan-preview__row">
                        <span class="plan-preview__row-label">Valor</span>
                        <span class="plan-preview__row-value">R$ <%= plan.price %></span>
                    </div>
                    <div class="plan-preview__row">
                        <span class="plan-preview__row-label">Duração</span>
                        <span class="plan-preview__row-value"><%= plan.formatted_duration %></span>
                    </div>
                    <div class="plan-preview__row">
                        <span class="plan-preview__row-label">Status</span>
                        <span class="plan-preview__row-value" style="color: var(--color-active);"><%= plan.formatted_active %></span>
                    </div>
                    
                    <!-- Ações -->
                    <div style="display: flex; gap: 8px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-border);">
                         <%= link_to edit_plan_path(plan), class:"btn-ghost btn-inspect" do %>
                            <svg style="display:inline;width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;vertical-align:middle;margin-right:6px;" viewBox="0 0 24 24" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>    
                            Inspecionar
                         <% end %>
                    </div>
                </div>
            </div>
            <% end %>
        </div>
    </main>

</body>
</html>