<% content_for :title, "Estatísticas" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "statistics", "data-turbo-track": "dynamic" %>
<% end %>

<% revenue_by_month = @stats.revenue_by_month %>
<% revenue_max      = revenue_by_month.map { |m| m[:value] }.max %>
<% growth           = @stats.revenue_growth %>
<% payment_methods  = @stats.payment_methods %>
<% enrollments      = @stats.enrollments_by_month %>
<% enrollments_max  = enrollments.flat_map { |m| [m[:new], m[:lost]] }.max %>
<% renewals         = @stats.renewals %>
<% renewal_rate     = @stats.renewal_rate %>
<% retention_diff   = renewal_rate - @stats.renewal_rate(@stats.today.prev_month) %>
<% students_by_plan = @stats.students_by_plan %>
<% students_by_age  = @stats.students_by_age %>
<% age_max          = students_by_age.map { |a| a[:value] }.max %>
<% previous_month   = l(@stats.today.prev_month, format: "%B") %>

<main class="main">

  <!-- CABEÇALHO -->
  <header class="page-header">
    <div>
      <h1 class="page-header__title">Estatísticas</h1>
      <p class="page-header__date">
        <svg class="icon_payments" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
        Resumo de <%= l(@stats.today, format: "%B de %Y") %>
      </p>
    </div>

    <div class="page-header__actions">
      <%= link_to :back, class: "btn-ghost" do %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Voltar
      <% end %>
    </div>
  </header>

  <!-- RESUMO -->
  <div class="metrics-grid">
    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Receita do mês</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
      </div>
      <div class="metric-card__value"><%= money(@stats.revenue) %></div>
      <div class="metric-card__trend <%= growth.to_f >= 0 ? "trend--up" : "trend--warn" %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <span class="trend__context">
          <% if growth %>
            <%= number_to_percentage(growth.abs, precision: 1) %> <%= growth >= 0 ? "acima" : "abaixo" %> de <%= previous_month %>
          <% else %>
            Sem receita em <%= previous_month %> para comparar
          <% end %>
        </span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Alunos ativos</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
      </div>
      <div class="metric-card__value"><%= @stats.active_students %></div>
      <div class="metric-card__trend trend--up">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <span class="trend__context">+<%= @stats.new_students %> no mês · <%= @stats.total_students %> cadastrados</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Inadimplência</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
      </div>
      <div class="metric-card__value"><%= money(@stats.overdue_amount) %></div>
      <div class="metric-card__trend trend--warn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span class="trend__context"><%= pluralize(@stats.overdue_students, "mensalidade vencida", plural: "mensalidades vencidas") %></span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Taxa de retenção</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
      </div>
      <div class="metric-card__value"><%= renewal_rate %>%</div>
      <div class="metric-card__trend <%= retention_diff >= 0 ? "trend--up" : "trend--warn" %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <span class="trend__context">
          <%= pluralize(retention_diff.abs, "ponto", plural: "pontos") %> <%= retention_diff >= 0 ? "acima" : "abaixo" %> de <%= previous_month %>
        </span>
      </div>
    </div>
  </div>

  <!-- FINANCEIRO -->
  <section class="stat-section" aria-labelledby="finance">
    <h2 id="finance" class="section-label">Financeiro</h2>

    <div class="stat-grid">
      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Receita mensal</h3>
          <p class="stat-card__subtitle">Últimos <%= GymStatistics::MONTHS %> meses, em R$ · ticket médio <%= number_to_currency(@stats.average_ticket) %></p>
        </header>
        <ul class="stat-columns">
          <% revenue_by_month.each do |month| %>
            <li class="stat-columns__item <%= "is-current" if month.equal?(revenue_by_month.last) %>">
              <span class="stat-columns__value"><%= short_money(month[:value]) %></span>
              <span class="stat-columns__area" aria-hidden="true">
                <span class="stat-columns__bar" style="height: <%= bar_percent(month[:value], revenue_max) %>%"></span>
              </span>
              <span class="stat-columns__label"><%= month_name(month[:month]) %></span>
            </li>
          <% end %>
        </ul>
      </article>

      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Formas de pagamento</h3>
          <p class="stat-card__subtitle">Participação na receita do mês</p>
        </header>
        <% if payment_methods.any? %>
          <div class="stat-donut-wrapper">
            <div class="stat-donut" aria-hidden="true" style="<%= donut_gradient(payment_methods) %>">
              <span class="stat-donut__center"><strong><%= payment_methods.first[:percent] %>%</strong></span>
            </div>
            <ul class="stat-legend">
              <% payment_methods.each_with_index do |method, index| %>
                <li class="stat-legend__item">
                  <span class="stat-swatch stat-swatch--<%= chart_color(index) %>" aria-hidden="true"></span>
                  <span class="stat-legend__label"><%= method[:label] %></span>
                  <span class="stat-legend__value"><%= method[:percent] %>%</span>
                </li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <p class="stat-card__subtitle">Nenhum pagamento neste mês.</p>
        <% end %>
      </article>
    </div>
  </section>

  <!-- RETENÇÃO -->
  <section class="stat-section" aria-labelledby="retention">
    <h2 id="retention" class="section-label">Retenção</h2>

    <div class="stat-grid">
      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Matrículas e evasões</h3>
          <ul class="stat-legend stat-legend--inline">
            <li class="stat-legend__item"><span class="stat-swatch stat-swatch--primary" aria-hidden="true"></span>Matrículas</li>
            <li class="stat-legend__item"><span class="stat-swatch stat-swatch--danger" aria-hidden="true"></span>Venceram sem renovar</li>
          </ul>
        </header>
        <ul class="stat-columns">
          <% enrollments.each do |month| %>
            <li class="stat-columns__item">
              <span class="stat-columns__value"><%= month[:new] %> / <%= month[:lost] %></span>
              <span class="stat-columns__area" aria-hidden="true">
                <span class="stat-columns__bar stat-columns__bar--primary" style="height: <%= bar_percent(month[:new], enrollments_max) %>%"></span>
                <span class="stat-columns__bar stat-columns__bar--danger" style="height: <%= bar_percent(month[:lost], enrollments_max) %>%"></span>
              </span>
              <span class="stat-columns__label"><%= month_name(month[:month]) %></span>
            </li>
          <% end %>
        </ul>
      </article>

      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Renovações do mês</h3>
          <p class="stat-card__subtitle"><%= renewals[:renewed] %> de <%= renewals[:expired] %> planos vencidos foram renovados</p>
        </header>
        <div class="stat-progress" aria-hidden="true">
          <span class="stat-progress__fill" style="width: <%= renewal_rate %>%"></span>
        </div>
        <dl class="stat-list">
          <div class="stat-list__row">
            <dt>Vencem em 7 dias</dt>
            <dd><%= pluralize(@stats.expiring_soon, "aluno") %></dd>
          </div>
          <div class="stat-list__row">
            <dt>Vencidos sem renovar</dt>
            <dd><%= pluralize(@stats.overdue_students, "aluno") %></dd>
          </div>
          <div class="stat-list__row">
            <dt>Evasão no mês</dt>
            <dd><%= @stats.dropout_rate %>%</dd>
          </div>
        </dl>
      </article>
    </div>
  </section>

  <!-- BASE DE ALUNOS -->
  <section class="stat-section" aria-labelledby="students-base">
    <h2 id="students-base" class="section-label">Base de alunos</h2>

    <div class="stat-grid">
      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Alunos por plano</h3>
          <p class="stat-card__subtitle"><%= pluralize(@stats.total_students, "aluno cadastrado", plural: "alunos cadastrados") %></p>
        </header>
        <div class="stat-stacked" aria-hidden="true">
          <% students_by_plan.each_with_index do |plan, index| %>
            <span class="stat-swatch--<%= chart_color(index) %>" style="width: <%= plan[:percent] %>%"></span>
          <% end %>
        </div>
        <ul class="stat-legend stat-legend--grid">
          <% students_by_plan.each_with_index do |plan, index| %>
            <li class="stat-legend__item">
              <span class="stat-swatch stat-swatch--<%= chart_color(index) %>" aria-hidden="true"></span>
              <span class="stat-legend__label"><%= plan[:label] %></span>
              <span class="stat-legend__value"><%= plan[:value] %> · <%= plan[:percent] %>%</span>
            </li>
          <% end %>
        </ul>
      </article>

      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Faixa etária</h3>
          <p class="stat-card__subtitle">
            <% if age_max.to_i.positive? %>
              Maior público: <%= students_by_age.max_by { |a| a[:value] }[:label] %> anos
            <% else %>
              Nenhuma data de nascimento cadastrada
            <% end %>
          </p>
        </header>
        <ul class="stat-bars">
          <% students_by_age.each do |age| %>
            <li class="stat-bars__row">
              <span class="stat-bars__label"><%= age[:label] %></span>
              <span class="stat-bars__track" aria-hidden="true">
                <span class="stat-bars__fill" style="width: <%= bar_percent(age[:value], age_max) %>%"></span>
              </span>
              <span class="stat-bars__value"><%= age[:value] %></span>
            </li>
          <% end %>
        </ul>
      </article>
    </div>
  </section>
</main>
