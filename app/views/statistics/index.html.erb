<% content_for :title, "Estatísticas" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "statistics", "data-turbo-track": "dynamic" %>
<% end %>

<%# Dados fictícios: página apenas demonstrativa, sem consulta ao banco. %>
<% revenue_by_month = [
  { label: "Jun", value: "15,2 mil", percent: 82 },
  { label: "Jul", value: "15,9 mil", percent: 87 },
  { label: "Ago", value: "16,7 mil", percent: 91 },
  { label: "Set", value: "17,1 mil", percent: 93 },
  { label: "Out", value: "17,9 mil", percent: 97 },
  { label: "Nov", value: "18,4 mil", percent: 100 }
] %>
<% payment_methods = [
  { label: "Pix",      percent: 58, color: "primary" },
  { label: "Crédito",  percent: 27, color: "accent" },
  { label: "Débito",   percent: 10, color: "secondary" },
  { label: "Dinheiro", percent: 5,  color: "inactive" }
] %>
<% enrollments = [
  { label: "Jun", new: 18, canceled: 9 },
  { label: "Jul", new: 20, canceled: 8 },
  { label: "Ago", new: 22, canceled: 8 },
  { label: "Set", new: 19, canceled: 6 },
  { label: "Out", new: 21, canceled: 8 },
  { label: "Nov", new: 24, canceled: 7 }
] %>
<% enrollments_max = 24 %>
<% students_by_plan = [
  { label: "Mensal",     count: 98, percent: 47, color: "primary" },
  { label: "Trimestral", count: 41, percent: 20, color: "accent" },
  { label: "Anual",      count: 32, percent: 15, color: "secondary" },
  { label: "Diária",     count: 15, percent: 7,  color: "active" },
  { label: "Vencidos",   count: 23, percent: 11, color: "danger" }
] %>
<% students_by_age = [
  { label: "18 a 25", count: 52, percent: 25 },
  { label: "26 a 35", count: 71, percent: 34 },
  { label: "36 a 45", count: 48, percent: 23 },
  { label: "46 ou +", count: 38, percent: 18 }
] %>

<main class="main">

  <!-- CABEÇALHO -->
  <header class="page-header">
    <div>
      <h1 class="page-header__title">Estatísticas</h1>
      <p class="page-header__date">
        <svg class="icon_payments" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
        Resumo de novembro de 2026 (demonstração)
      </p>
    </div>

    <div class="page-header__actions">
      <%= link_to root_path, class: "btn-ghost" do %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Voltar
      <% end %>
    </div>
  </header>

  <!-- RESUMO -->
  <div class="metrics-grid">
    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Receita do mês</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
      </div>
      <div class="metric-card__value">R$ 18.420</div>
      <div class="metric-card__trend trend--up">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <span class="trend__context">3,1% acima de outubro</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Alunos ativos</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
      </div>
      <div class="metric-card__value">186</div>
      <div class="metric-card__trend trend--up">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <span class="trend__context">+17 no mês · 209 cadastrados</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Inadimplência</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
      </div>
      <div class="metric-card__value">R$ 2.300</div>
      <div class="metric-card__trend trend--warn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span class="trend__context">23 mensalidades vencidas</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-card__header">
        <span class="metric-card__label">Taxa de retenção</span>
        <span class="metric-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
      </div>
      <div class="metric-card__value">91%</div>
      <div class="metric-card__trend trend--up">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <span class="trend__context">2 pontos acima de outubro</span>
      </div>
    </div>
  </div>

  <!-- FINANCEIRO -->
  <section class="stat-section" aria-labelledby="finance">
    <h2 id="finance" class="section-label">Financeiro</h2>

    <div class="stat-grid">
      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Receita mensal</h3>
          <p class="stat-card__subtitle">Últimos 6 meses, em R$ · ticket médio R$ 99,03 · previsão de dezembro R$ 18,9 mil</p>
        </header>
        <ul class="stat-columns">
          <% revenue_by_month.each_with_index do |month, index| %>
            <li class="stat-columns__item <%= "is-current" if index == revenue_by_month.size - 1 %>">
              <span class="stat-columns__value"><%= month[:value] %></span>
              <span class="stat-columns__area" aria-hidden="true">
                <span class="stat-columns__bar" style="height: <%= month[:percent] %>%"></span>
              </span>
              <span class="stat-columns__label"><%= month[:label] %></span>
            </li>
          <% end %>
        </ul>
      </article>

      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Formas de pagamento</h3>
          <p class="stat-card__subtitle">Participação na receita do mês</p>
        </header>
        <div class="stat-donut-wrapper">
          <div class="stat-donut" aria-hidden="true"
               style="background: conic-gradient(var(--color-primary) 0 58%, var(--color-accent) 0 85%, var(--color-secondary) 0 95%, var(--color-inactive) 0 100%)">
            <span class="stat-donut__center"><strong>58%</strong>Pix</span>
          </div>
          <ul class="stat-legend">
            <% payment_methods.each do |method| %>
              <li class="stat-legend__item">
                <span class="stat-swatch stat-swatch--<%= method[:color] %>" aria-hidden="true"></span>
                <span class="stat-legend__label"><%= method[:label] %></span>
                <span class="stat-legend__value"><%= method[:percent] %>%</span>
              </li>
            <% end %>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- RETENÇÃO -->
  <section class="stat-section" aria-labelledby="retention">
    <h2 id="retention" class="section-label">Retenção</h2>

    <div class="stat-grid">
      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Matrículas e cancelamentos</h3>
          <ul class="stat-legend stat-legend--inline">
            <li class="stat-legend__item"><span class="stat-swatch stat-swatch--primary" aria-hidden="true"></span>Matrículas</li>
            <li class="stat-legend__item"><span class="stat-swatch stat-swatch--danger" aria-hidden="true"></span>Cancelamentos</li>
          </ul>
        </header>
        <ul class="stat-columns">
          <% enrollments.each do |month| %>
            <li class="stat-columns__item">
              <span class="stat-columns__value"><%= month[:new] %> / <%= month[:canceled] %></span>
              <span class="stat-columns__area" aria-hidden="true">
                <span class="stat-columns__bar stat-columns__bar--primary" style="height: <%= month[:new] * 100 / enrollments_max %>%"></span>
                <span class="stat-columns__bar stat-columns__bar--danger" style="height: <%= month[:canceled] * 100 / enrollments_max %>%"></span>
              </span>
              <span class="stat-columns__label"><%= month[:label] %></span>
            </li>
          <% end %>
        </ul>
      </article>

      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Renovações do mês</h3>
          <p class="stat-card__subtitle">142 de 156 planos renovados</p>
        </header>
        <div class="stat-progress" aria-hidden="true">
          <span class="stat-progress__fill" style="width: 91%"></span>
        </div>
        <dl class="stat-list">
          <div class="stat-list__row">
            <dt>Vencem em 7 dias</dt>
            <dd>15 alunos</dd>
          </div>
          <div class="stat-list__row">
            <dt>Vencidos sem renovar</dt>
            <dd>23 alunos</dd>
          </div>
          <div class="stat-list__row">
            <dt>Evasão no mês</dt>
            <dd>3,7%</dd>
          </div>
          <div class="stat-list__row">
            <dt>Frequência média</dt>
            <dd>3,2 treinos/semana</dd>
          </div>
        </dl>
      </article>
    </div>
  </section>

  <!-- BASE DE ALUNOS -->
  <section class="stat-section" aria-labelledby="students-base">
    <h2 id="students-base" class="section-label">Base de alunos</h2>

    <div class="stat-grid">
      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Alunos por plano</h3>
          <p class="stat-card__subtitle">209 alunos cadastrados</p>
        </header>
        <div class="stat-stacked" aria-hidden="true">
          <% students_by_plan.each do |plan| %>
            <span class="stat-swatch--<%= plan[:color] %>" style="width: <%= plan[:percent] %>%"></span>
          <% end %>
        </div>
        <ul class="stat-legend stat-legend--grid">
          <% students_by_plan.each do |plan| %>
            <li class="stat-legend__item">
              <span class="stat-swatch stat-swatch--<%= plan[:color] %>" aria-hidden="true"></span>
              <span class="stat-legend__label"><%= plan[:label] %></span>
              <span class="stat-legend__value"><%= plan[:count] %> · <%= plan[:percent] %>%</span>
            </li>
          <% end %>
        </ul>
      </article>

      <article class="stat-card">
        <header class="stat-card__header">
          <h3 class="stat-card__title">Faixa etária</h3>
          <p class="stat-card__subtitle">Maior público entre 26 e 35 anos</p>
        </header>
        <ul class="stat-bars">
          <% students_by_age.each do |age| %>
            <li class="stat-bars__row">
              <span class="stat-bars__label"><%= age[:label] %></span>
              <span class="stat-bars__track" aria-hidden="true">
                <span class="stat-bars__fill" style="width: <%= age[:percent] %>%"></span>
              </span>
              <span class="stat-bars__value"><%= age[:count] %></span>
            </li>
          <% end %>
        </ul>
      </article>
    </div>
  </section>
</main>
